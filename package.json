{
  "name": "datoko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <26" },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "worker:production": "tsx src/worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:db": "tsx --test tests/*.integration.ts",
    "test:e2e": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "check": "npm run test && npm run typecheck",
    "secrets": "node scripts/generate-secrets.mjs"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.1.0",
    "better-auth": "^1.7.10",
    "dotenv": "^16.6.1",
    "next": "^16.4.1",
    "pg": "^8.16.3",
    "pg-boss": "12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^7.10.0",
    "typescript": "^5.9.2"
  }
}
