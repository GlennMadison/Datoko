# Demo shows fixture data and cannot access Shopee or change live records.
DATOKO_MODE=demo
APP_BASE_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Jakarta
DATABASE_URL=postgresql://datoko:datoko_local@localhost:5432/datoko

# Generate fresh values with npm run secrets. Never commit .env.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Email/password login works without Google credentials.
AUTH_METHOD=email-password
# Create your owner account locally, then set false to close signup.
EMAIL_SIGNUP_ENABLED=true
OWNER_EMAIL=
# Optional: switch AUTH_METHOD to google to use these instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional extra restriction after the first Google sign-in.
OWNER_GOOGLE_SUB=
TOKEN_ENCRYPTION_KEY=

SHOPEE_ENV=sandbox
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ALLOWED_SHOP_IDS=
SHOPEE_REDIRECT_URI=http://localhost:3000/api/integrations/shopee/callback
# Sandbox V2 uses echoed state; leave false for sandbox testing.
# The legacy production adapter requires a verified auth_state query round trip.
SHOPEE_CALLBACK_QUERY_VERIFIED=false
# Confirm these conservative window sizes/history against your console contract.
SHOPEE_MAX_WINDOW_DAYS=7
SHOPEE_HISTORY_DAYS=30
SYNC_INTERVAL_MINUTES=10
INITIAL_IMPORT_DAYS=30
